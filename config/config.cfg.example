[search]
# Search configuration parameters
# Control the default behavior of document search operations

# top_k: Maximum number of documents to return (default: 10)
top_k = 10

# chunk_k: Maximum number of matched chunks per document to include (default: 3)
chunk_k = 3

# min_score: Minimum combined score threshold for results (default: 0.01)
min_score = 0.01

# hybrid: Use hybrid semantic+keyword scoring (default: false)
# When true, combines embedding similarity with keyword match boost
# Recommended for English queries; may hurt precision for Vietnamese/other languages
hybrid = true

# hybrid_weight: Weight given to keyword score in hybrid mode (0-1, default: 0.1)
# Only applies when hybrid=true
# Higher values = more keyword matching influence, lower = more semantic focus
hybrid_weight = 0.1

[logging]
# Logging categories
# Available categories: vector.store, embedding.model, embedding.encode, embedding.store, processor, db.store, pdf.scanner, scraper
# debug: Enable debug output for enabled logging categories (default: false)
debug = false
categories = processor, vector.store, db.store, pdf.scanner, scraper

[database]
# PostgreSQL connection for storing chunks and embeddings
# Either set url or individual connection parameters
# url = postgresql://user:password@localhost:5432/docchatbot
host = localhost
port = 5432
name = docchatbot
user = docuser
# password = your_password_here

[generator]
# Generator configuration for RAG (Retrieval-Augmented Generation)
# Provider: hf_api, local, openai
# hf_api = HuggingFace Inference API (default)
# local = Local transformers model (requires GPU)
# openai = OpenAI API
provider = hf_api

# Model name for the provider (CHANGE THIS TO SWITCH MODELS)
# For hf_api: Use models available on HuggingFace Inference API (free tier has limited models)
#   - Recommended: mistralai/Mistral-7B-Instruct-v0.3 (works with free tier)
#   - Alternative: microsoft/Phi-3-mini-4k-instruct
# For local: mistralai/Mistral-7B-Instruct-v0.2, mistralai/Mistral-7B-Instruct-v0.3
# For openai: gpt-4o-mini, gpt-3.5-turbo, gpt-4-turbo
#   When api_type=openai, you can also set api_base_url to point to a compatible endpoint
model_name = mistralai/Mistral-7B-Instruct-v0.3

# OpenAI-compatible API credentials (used when provider=openai)
# api_key = your_openai_api_key
# api_base_url = https://api-inference.huggingface.co/models/Qwen/Qwen2.5-7B-Instruct/v1

# Generation parameters
max_new_tokens = 512
temperature = 0.7
top_p = 0.95